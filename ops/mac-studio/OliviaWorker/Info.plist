<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OliviaWorker.app — macOS TCC 권한 영구 수정.

  build-and-install.sh가 이 파일을 ~/Applications/OliviaWorker.app/Contents/Info.plist로
  그대로 복사한다. LSUIElement=true라 Dock/메뉴바 아이콘이 없다 — 백그라운드 에이전트다.
-->
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>OliviaWorker</string>

  <key>CFBundleIdentifier</key>
  <string>com.olivia.macstudio.oliviaworker</string>

  <key>CFBundleName</key>
  <string>OliviaWorker</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleShortVersionString</key>
  <string>1.0</string>

  <key>CFBundleVersion</key>
  <string>1</string>

  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>

  <key>LSUIElement</key>
  <true/>

  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
