<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Olivia OS 2.0 PHASE 6 — NAS Backup Watcher User LaunchAgent.

  §14 "SOURCE_ROOT가 SMB user mount이므로 system LaunchDaemon보다는 User LaunchAgent를
  우선 사용한다" — 반드시 ~/Library/LaunchAgents/ 에 설치한다(root의 /Library/LaunchAgents 아님).

  설치 전 아래 두 곳을 실제 경로로 바꿔야 한다(placeholder를 그대로 두면 시작하지 못한다):
    1. <OLIVIA_REPO_PATH> — 이 Next.js 저장소를 Mac Studio에 clone한 절대경로
    2. 필요하면 REMOTE_API_BASE/WORKER_TOKEN/WORKER_ID/VERCEL_BYPASS_SECRET을
       EnvironmentVariables에 직접 채운다(비워두면 스크립트가 ~/OliviaWorker/config/worker.env를
       자동으로 읽는다 — worker.env에 이미 값이 있으면 이 항목들은 생략해도 된다).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.olivia.macstudio.nas-watcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "<OLIVIA_REPO_PATH>" &amp;&amp; exec node --import tsx scripts/nas-backup-watcher.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string><OLIVIA_REPO_PATH></string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- worker.sh/remote-bridge.sh와 동일한 실행 신원(로그인 사용자)으로 SMB mount에
       접근해야 하므로, 이 plist는 root가 아니라 로그인 사용자로 launchd에 등록된다
       (User LaunchAgent 자체가 이미 그 조건을 보장한다 — LaunchDaemon과 달리 root로
       실행되지 않는다). -->

  <!-- §4/§14 기존 OliviaWorker/logs 디렉터리를 그대로 쓴다(이미 존재, 새 폴더 안 만듦). -->
  <key>StandardOutPath</key>
  <string>/Users/jakemacstudio/OliviaWorker/logs/nas-watcher.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jakemacstudio/OliviaWorker/logs/nas-watcher.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <!-- §4 상태 파일을 OliviaWorker/state 아래에 둔다(기존 폴더 구조 재사용). -->
    <key>OLIVIA_NAS_WATCH_STATE_PATH</key>
    <string>/Users/jakemacstudio/OliviaWorker/state/nas-watcher.json</string>
  </dict>
</dict>
</plist>
